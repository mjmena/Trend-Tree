# trend-tree-editorial-ingest deploy configuration (CRMA-1667, spec CRMA-1660).
# Sourced by services/deploy.sh. NO SECRET VALUES LIVE HERE.

SERVICE=trend-tree-editorial-ingest

# A Python (FastAPI) service: deploy.sh stages tt_services_lib + PY_PACKAGE
# onto python:3.12-slim and runs `python -m ${PY_PACKAGE}.server`.
RUNTIME=python
PY_PACKAGE=editorial_ingest

PROJECT=mcc-crm-automations
REGION=us-east4
REPO=mcc
SERVICE_ACCOUNT=crm-runtime@mcc-crm-automations.iam.gserviceaccount.com

# allUsers -> roles/run.invoker (the harbor-api pattern). ATLAS calls with
# X-Api-Key, which the app checks; the task handler checks Cloud Tasks' OIDC
# token itself. The ONLY service that sets this.
PUBLIC_INGRESS=true

# Capacity is the instance cap, nothing in code (spec); overflow gets Cloud
# Run's own 429. Concurrency stays deploy.sh's default.
CPU=1
MEMORY=512Mi
MIN_INSTANCES=0
MAX_INSTANCES=2
# Matches the task's dispatchDeadline (editorial_ingest/tasks.py, 900s).
TIMEOUT=900
PORT=8080
HEALTH_PATH=/health

# EDITORIAL_SERVICE_URL is the base service URL: the handler's OIDC audience
# and the tasks' target. Deterministic in this project (<service>-tu6gxkvema-uk).
ENV_VARS="
EDITORIAL_SERVICE_URL: 'https://trend-tree-editorial-ingest-tu6gxkvema-uk.a.run.app'
EDITORIAL_TASKS_PROJECT: 'mcc-crm-automations'
EDITORIAL_TASKS_LOCATION: 'us-east4'
EDITORIAL_TASKS_QUEUE: 'trend-tree-editorial-ingest'
EDITORIAL_TASKS_SERVICE_ACCOUNT: 'crm-runtime@mcc-crm-automations.iam.gserviceaccount.com'
EDITORIAL_SNOWFLAKE_ACCOUNT: 'WVB49304-MCCLATCHY_EVAL'
EDITORIAL_SNOWFLAKE_USER: 'CRMBOT_SERVICE_USER'
EDITORIAL_SNOWFLAKE_ROLE: 'MARKETING_ENGINEER'
EDITORIAL_SNOWFLAKE_WAREHOUSE: 'MARKETING_WH'
EDITORIAL_DISPATCHER_URL: 'https://eoqf5zok2vcvael.m.pipedream.net'
"

# editorial-ingest-api-key: the one key ATLAS prod (insights-agent-504817)
# holds a copy of. Must exist before the first deploy. Rotation is a manual
# swap coordinated with the ATLAS team (add a version, they switch, disable
# the old one).
SECRETS="EDITORIAL_API_KEY=editorial-ingest-api-key:latest,EDITORIAL_SNOWFLAKE_PRIVATE_KEY=snowflake-private-key:latest,EDITORIAL_GEMINI_API_KEY=generic-gemini-api-key:latest"
