# trend-tree-ecomm-agent deploy configuration (CRMA-776, epic CRMA-772).
# Sourced by services/deploy.sh. NO SECRET VALUES LIVE HERE — secrets are
# named, and Secret Manager supplies them at runtime (see SECRETS below).

SERVICE=trend-tree-ecomm-agent

# GCP coordinates, per CRMA-437: the fleet shares the existing
# mcc-crm-automations project and its existing `mcc` Artifact Registry repo.
PROJECT=mcc-crm-automations
REGION=us-east4
REPO=mcc
SERVICE_ACCOUNT=crm-runtime@mcc-crm-automations.iam.gserviceaccount.com

# Sizing. TIMEOUT is deliberately well above Cloud Run's 300s default per
# CRMA-436: a sourcing run is a Snowflake vector scan plus one Gemini call
# (seconds in practice), but the default cap is the constraint that shaped the
# whole Pipedream-era suspend/resume workaround and there is no reason to
# inherit it here.
CPU=1
MEMORY=512Mi
MIN_INSTANCES=0
MAX_INSTANCES=5
CONCURRENCY=10
TIMEOUT=900
PORT=8080

# Route the smoke test hits at the candidate tag URL before traffic is
# promoted (CRMA-440). Deliberately NOT /healthz — Google's edge intercepts
# that exact path on *.run.app and answers its own 404 before Cloud Run sees
# the request, which fails the smoke test on a perfectly healthy revision
# (diagnosed on CRMA-762).
HEALTH_PATH=/health

# Plain configuration, passed as --env-vars-file. The Snowflake identity is
# the same CRMBOT_SERVICE_USER / MARKETING_ENGINEER pair the retired Pipedream
# connected account (apn_yghdQYJ) used.
ENV_VARS="
SNOWFLAKE_ACCOUNT: 'WVB49304-MCCLATCHY_EVAL'
SNOWFLAKE_USER: 'CRMBOT_SERVICE_USER'
SNOWFLAKE_ROLE: 'MARKETING_ENGINEER'
SNOWFLAKE_WAREHOUSE: 'MARKETING_WH'
SNOWFLAKE_DATABASE: 'MCC_PRESENTATION'
SNOWFLAKE_SCHEMA: 'TREND_AGENT'
"

# Secret Manager -> env var. crm-runtime@ holds project-level
# roles/secretmanager.secretAccessor, so no per-secret IAM binding is needed.
#   snowflake-private-key     — already exists in mcc-crm-automations.
#   generic-gemini-api-key    — the shared Gemini key, confirmed present
#                               2026-08-21 (version 1, enabled). It is shared
#                               across services rather than owned by this one,
#                               hence "generic"; if the ecomm agent ever needs
#                               its own quota or rotation cadence, give it a
#                               dedicated secret and change only this line.
SECRETS="SNOWFLAKE_PRIVATE_KEY=snowflake-private-key:latest,GEMINI_API_KEY=generic-gemini-api-key:latest"
