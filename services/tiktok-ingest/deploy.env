# trend-tree-tiktok-ingest deploy configuration (CRMA-1337, epic CRMA-1336).
# Sourced by services/deploy.sh. NO SECRET VALUES LIVE HERE.

# A Cloud Run JOB, not a service: it runs one ingest and exits, and nothing
# calls it over HTTP. deploy.sh takes its job path on KIND=job — no traffic
# split, no health route; the smoke test is one real execution, which spends
# up to 50 SerpApi searches of the shared plan.
KIND=job
SERVICE=trend-tree-tiktok-ingest
ENTRYPOINT=ingest.mjs

PROJECT=mcc-crm-automations
REGION=us-east4
REPO=mcc
SERVICE_ACCOUNT=crm-runtime@mcc-crm-automations.iam.gserviceaccount.com

# Up to 50 searches in waves of 4 (34-66s each uncached, 120s client timeout)
# plus a filter call per ~40 titles. About 10 minutes for 24 seeds; the worst
# case (13 waves at the 120s timeout) is 26 minutes, inside the timeout.
CPU=1
MEMORY=512Mi
TIMEOUT=3600

# One retry (spec user story 15). A retry within the hour costs no SerpApi
# quota — SerpApi serves repeated identical queries from its cache — and the
# MERGE on SIGNAL_ID plus the video-ID dedup make it write nothing twice.
MAX_RETRIES=1

ENV_VARS="
SNOWFLAKE_ACCOUNT: 'WVB49304-MCCLATCHY_EVAL'
SNOWFLAKE_USER: 'CRMBOT_SERVICE_USER'
SNOWFLAKE_ROLE: 'MARKETING_ENGINEER'
SNOWFLAKE_WAREHOUSE: 'MARKETING_WH'
SNOWFLAKE_DATABASE: 'MCC_RAW'
SNOWFLAKE_SCHEMA: 'MARKETING_DEV'
"

# Secret Manager -> env var. crm-runtime@ holds project-level
# roles/secretmanager.secretAccessor, so no per-secret IAM binding is needed.
#   snowflake-private-key   — already exists in mcc-crm-automations.
#   generic-gemini-api-key  — the shared Gemini key the ecomm agent also uses.
#   serpapi-api-key         — created for CRMA-1337 from the Keychain item
#                             `serpapi-api` (the shared dev@trendhunter.com plan).
SECRETS="SNOWFLAKE_PRIVATE_KEY=snowflake-private-key:latest,GEMINI_API_KEY=generic-gemini-api-key:latest,SERPAPI_API_KEY=serpapi-api-key:latest"
