# trend-tree-lifecycle deploy configuration. Sourced by services/deploy.sh.
# NO SECRET VALUES LIVE HERE.

# A Cloud Run JOB: one tick per execution, started hourly by Cloud Scheduler.
# Deploy with --no-execute until the cut-over: an execution writes ledger rows.
KIND=job
SERVICE=trend-tree-lifecycle
ENTRYPOINT=tick.mjs

PROJECT=mcc-crm-automations
REGION=us-east4
REPO=mcc
SERVICE_ACCOUNT=crm-runtime@mcc-crm-automations.iam.gserviceaccount.com

CPU=1
MEMORY=512Mi
# Two attempts (one retry) end inside the hour, so a retried tick cannot
# overlap the next one.
TIMEOUT=1500

# Collect skips trends already in the ledger, so a retried tick applies nothing twice.
MAX_RETRIES=1

# LIFECYCLE_BATCH_CAP: trends per Gemini batch. Override with
# `gcloud run jobs update ... --update-env-vars LIFECYCLE_BATCH_CAP=<n>`.
ENV_VARS="
LIFECYCLE_BATCH_CAP: '200'
SNOWFLAKE_ACCOUNT: 'WVB49304-MCCLATCHY_EVAL'
SNOWFLAKE_USER: 'CRMBOT_SERVICE_USER'
SNOWFLAKE_ROLE: 'MARKETING_ENGINEER'
SNOWFLAKE_WAREHOUSE: 'MARKETING_WH'
SNOWFLAKE_DATABASE: 'MCC_RAW'
SNOWFLAKE_SCHEMA: 'MARKETING_DEV'
"

SECRETS="SNOWFLAKE_PRIVATE_KEY=snowflake-private-key:latest,GEMINI_API_KEY=generic-gemini-api-key:latest"
