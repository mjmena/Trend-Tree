# trend-tree-scrape-gateway deploy configuration (CRMA-986, map CRMA-977).
# Sourced by services/deploy.sh. NO SECRET VALUES LIVE HERE — secrets are
# named, and Secret Manager supplies them at runtime (see SECRETS below).

SERVICE=trend-tree-scrape-gateway

# Same GCP coordinates as the rest of the fleet (CRMA-437): the shared
# mcc-crm-automations project and its existing `mcc` Artifact Registry repo.
PROJECT=mcc-crm-automations
REGION=us-east4
REPO=mcc
SERVICE_ACCOUNT=crm-runtime@mcc-crm-automations.iam.gserviceaccount.com

# Sizing. TIMEOUT is 300 — deliberately NOT the ecomm agent's 900. CRMA-985's
# contract is always-async: POST /pull triggers a vendor job and returns a
# job_id immediately, GET /pull/{job_id} reports on it. No request ever waits
# on a vendor scrape, so the long timeout that service needs does not apply.
#
# MAX_INSTANCES=3 is low because callers are scheduled ingesters, not user
# traffic. It is also why the gateway holds no job state in memory — see
# services/lib/scrape_job_id.mjs, which explains why the job id is
# self-describing rather than a key into a per-instance map.
CPU=1
MEMORY=512Mi
MIN_INSTANCES=0
MAX_INSTANCES=3
CONCURRENCY=10
TIMEOUT=300
PORT=8080

# Deliberately NOT /healthz — Google's edge intercepts that exact path on
# *.run.app and answers its own 404 before Cloud Run sees the request, which
# fails the dark-deploy smoke test on a perfectly healthy revision (diagnosed
# on CRMA-762).
HEALTH_PATH=/health

# Plain configuration, passed as --env-vars-file.
#
# Dataset ids are NOT secret and live here on purpose: CRMA-985 decided that a
# dataset swap should be a config change, not a code change. Bright Data
# retires and replaces datasets without notice, and the alternative — the id
# baked into a normalizer — turns that into a rebuild and a redeploy.
#
# SOURCES_ENABLED is the per-source kill switch. A platform removed from this
# list is refused at POST /pull with a 403, which is the lever to pull when a
# scraped surface starts returning junk (the TikTok precedent: the Creative
# Center page 301'd away and the scraper kept "succeeding"). It is a kill
# switch, not a quota — see SECRETS below for where the spend cap really lives.
ENV_VARS="
BD_DATASET_TIKTOK_POSTS: 'gd_lu702nij2f790tmv9h'
BD_DATASET_REDDIT_POSTS: 'gd_lvz8ah06191smkebj4'
SOURCES_ENABLED: 'tiktok,reddit,kickstarter'
"

# Secret Manager -> env var. crm-runtime@ holds project-level
# roles/secretmanager.secretAccessor, so no per-secret IAM binding is needed.
#
#   brightdata-api-key — MUST BE CREATED BEFORE THE FIRST DEPLOY. Unlike the
#   ecomm agent's secrets this one is new to the project; `gcloud run deploy`
#   fails outright if it does not exist. CRMA-986 creates it from the key
#   minted during vendor provisioning.
#
# THE SPEND CAP IS NOT HERE. CRMA-985 decided the gateway enforces no quota of
# its own: the cap lives in the Bright Data account, where it is authoritative
# and cannot be bypassed by a caller that skips the gateway. A per-request
# max_records fuse was proposed and declined — a second config to keep in sync
# that would also obstruct a legitimate backfill.
SECRETS="BRIGHTDATA_API_KEY=brightdata-api-key:latest"
