# trend-tree-catalog-sync deploy configuration (CRMA-777, epic CRMA-772).
# Sourced by services/deploy.sh. NO SECRET VALUES LIVE HERE.

# A Cloud Run JOB, not a service: it runs one sweep and exits, and nothing
# calls it over HTTP. deploy.sh takes its job path on KIND=job — no traffic
# split, no health route; the smoke test is one real execution.
KIND=job
SERVICE=trend-tree-catalog-sync
ENTRYPOINT=sync.mjs

PROJECT=mcc-crm-automations
REGION=us-east4
REPO=mcc
SERVICE_ACCOUNT=crm-runtime@mcc-crm-automations.iam.gserviceaccount.com

# A sweep is one or two feed requests plus ~6 MERGE batches; the first live
# sweep re-embeds ~30 products through Cortex. Minutes at most — the timeout
# is headroom, not an estimate.
CPU=1
MEMORY=512Mi
TIMEOUT=900

# One retry. A sweep is idempotent (unchanged products hash-match and only
# touch LAST_SEEN_AT), so a retry after a transient Snowflake or feed error
# is safe. A hard feed failure (401, empty page 1) fails both attempts, and
# the audit's catalog-freshness row reports it.
MAX_RETRIES=1

ENV_VARS="
SHOPIFY_STORE_URL: 'https://shoptrendhunter.myshopify.com'
SNOWFLAKE_ACCOUNT: 'WVB49304-MCCLATCHY_EVAL'
SNOWFLAKE_USER: 'CRMBOT_SERVICE_USER'
SNOWFLAKE_ROLE: 'MARKETING_ENGINEER'
SNOWFLAKE_WAREHOUSE: 'MARKETING_WH'
SNOWFLAKE_DATABASE: 'MCC_PRESENTATION'
SNOWFLAKE_SCHEMA: 'TREND_AGENT'
"

# Only the Snowflake key. The storefront feed needs no Shopify credential
# (CRMA-747); trend-tree-shopify-token was never provisioned.
SECRETS="SNOWFLAKE_PRIVATE_KEY=snowflake-private-key:latest"
