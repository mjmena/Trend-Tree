# Load nix environment
use flake . --impure

# Local-only secrets (Confluence creds for mark, etc.) — .envrc.local is gitignored.
# Create it with:
#   export CONFLUENCE_USER="you@mcclatchy.com"
#   export CONFLUENCE_API_TOKEN="<atlassian api token>"
#   export CONFLUENCE_SPACE_KEY="<space key>"
source_env_if_exists .envrc.local
